[Unit]
Description=computeMCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --config is omitted on purpose: the gateway defaults to
# %h/.config/computeMCP-gateway/config.toml (and its sibling tokens.toml).
# `pipx install` exposes the command in %h/.local/bin; referencing the shim
# directly means the service needs no shell and no PATH.
ExecStart=%h/.local/bin/computeMCP-gateway --no-console
# `systemctl --user reload computeMCP-gateway` re-reads the config and
# token file without dropping live tunnels.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# Prevent privilege gains through exec; install as a non-root user service.
NoNewPrivileges=true
# A user service's PrivateTmp implies a user namespace which can hide root's
# ownership of SSH configuration files, causing ssh -G to reject them.
PrivateTmp=false

[Install]
WantedBy=default.target
